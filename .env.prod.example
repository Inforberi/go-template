# Имя Docker Compose-проекта.
APP_NAME=go-template
# Режим работы приложения.
APP_ENV=prod
# Имя сервиса в логах.
SERVICE_NAME=api
# HTTP-порт API на хосте.
PORT=8080
# Логин Basic Auth для Swagger UI.
SWAGGER_USERNAME=swagger
# Пароль Basic Auth для Swagger UI. Замените перед deploy.
SWAGGER_PASSWORD=change-me

# Logger
# Минимальный уровень логирования.
LOG_LEVEL=info

# PostgreSQL
# Образ PostgreSQL для production.
POSTGRES_IMAGE=postgres:18.6-bookworm
# Имя базы данных.
POSTGRES_DB=app
# Владелец базы данных.
POSTGRES_USER=app
# Пароль владельца базы данных. Замените перед deploy.
POSTGRES_PASSWORD=change-me
# Каталог с данными production PostgreSQL относительно корня проекта.
POSTGRES_HOST_DIR=./data/postgres-prod
# Строка подключения API к PostgreSQL внутри Docker-сети.
DATABASE_URL=postgres://app:change-me@postgres:5432/app?sslmode=disable

# PostgreSQL backups
# Каталог backup на сервере, относительно корня проекта или абсолютный.
BACKUP_HOST_DIR=./backups
# Минимальный интервал между автоматическими backup.
BACKUP_INTERVAL=24h
# Сколько корректных backup-пар хранить.
BACKUP_RETENTION_COUNT=7
# SQL-проверка после успешного restore.
RESTORE_HEALTHCHECK_SQL=SELECT 1
