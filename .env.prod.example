APP_NAME=go-template
APP_IMAGE=ghcr.io/your-org/go-template:0.1.0
APP_ENV=prod
SERVICE_NAME=api
PORT=8080
SWAGGER_USERNAME=swagger
SWAGGER_PASSWORD=change-me

# Logger
LOG_LEVEL=info

# PostgreSQL
POSTGRES_IMAGE=postgres:18.6-bookworm
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://app:change-me@postgres:5432/app?sslmode=disable

# PostgreSQL backups
BACKUP_HOST_DIR=./backups
BACKUP_INTERVAL=24h
BACKUP_RETENTION_COUNT=7
RESTORE_HEALTHCHECK_SQL=SELECT 1
