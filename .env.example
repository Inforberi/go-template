# Имя Docker Compose-проекта.
APP_NAME=go-template
# Режим работы приложения.
APP_ENV=dev
# Имя сервиса в логах.
SERVICE_NAME=api
# HTTP-порт API на хосте.
PORT=8080
# Логин Basic Auth для Swagger UI.
SWAGGER_ENABLED=true
SWAGGER_USERNAME=swagger
# Пароль Basic Auth для Swagger UI.
SWAGGER_PASSWORD=swagger

# Logger
# Минимальный уровень логирования.
LOG_LEVEL=debug

# PostgreSQL
# Образ PostgreSQL для development.
POSTGRES_IMAGE=postgres:18.6-bookworm
# Имя базы данных.
POSTGRES_DB=app
# Владелец базы данных.
POSTGRES_USER=app
# Пароль владельца базы данных.
POSTGRES_PASSWORD=app
# Внешний порт PostgreSQL на хосте.
POSTGRES_PORT=5432
# Каталог с данными development PostgreSQL относительно корня проекта.
POSTGRES_HOST_DIR=./data/postgres-dev
# Строка подключения API к PostgreSQL внутри Docker-сети.
DATABASE_URL=postgres://app:app@postgres:5432/app?sslmode=disable
# Максимальное число соединений API с PostgreSQL.
DATABASE_MAX_CONNS=10
